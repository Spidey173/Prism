POSTGRES_DB=auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=auditor
DATABASE_URL=postgresql+psycopg:///auditor?port=5433
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=50000000
MAX_PDF_PAGES=500
EMBEDDING_DIM=384
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# ============================================================================
# LLM Provider Configuration
# Works with ANY environment: OpenAI, Anthropic, Gemini, Groq, Ollama, Local, etc.
# ============================================================================
# Supported presets: openai, gemini, google, anthropic, claude, groq, openrouter,
#                    ollama, local, vllm, lmstudio, deepseek, mistral, together, azure, fake
# Auto-detection: If LLM_PROVIDER is unset or default 'openai', setting ANTHROPIC_API_KEY,
#                 GEMINI_API_KEY, GROQ_API_KEY, or OLLAMA_HOST will auto-select the provider!
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1

# Provider Examples:
# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-... (or export OPENAI_API_KEY=...)
# LLM_MODEL=gpt-4o-mini
#
# --- Anthropic (Claude) ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-... (or export ANTHROPIC_API_KEY=...)
# LLM_MODEL=claude-3-5-haiku-20241022
#
# --- Google Gemini ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy... (or export GEMINI_API_KEY=...)
# LLM_MODEL=gemini-1.5-flash
#
# --- Groq ---
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_... (or export GROQ_API_KEY=...)
# LLM_MODEL=llama-3.3-70b-versatile
#
# --- Ollama (Local - NO API key required!) ---
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3.2
#
# --- Local / vLLM / LMStudio (NO API key required!) ---
# LLM_PROVIDER=local
# LLM_API_BASE=http://localhost:8000/v1
# LLM_MODEL=default
#
# --- Dry Run / Testing (No credentials needed!) ---
# LLM_PROVIDER=fake

LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_MAX_COST_PER_AUDIT_USD=0.50
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=90

SEMANTIC_TOP_K=5
SEMANTIC_SIMILARITY_THRESHOLD=0.70
SEMANTIC_MIN_CHUNK_DISTANCE=12
SEMANTIC_MAX_PAIRS_PER_AUDIT=50
SEMANTIC_CONFIDENCE_THRESHOLD=0.75
